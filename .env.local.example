# UGCOrigin — environment (copy to .env.local and fill in)
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the client. Used for money movement / admin ops.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which social sign-in buttons to show — only list providers you've actually
# enabled in Supabase (Auth → Providers). Comma-separated: google, meta, x.
# Unset = "google" only (Meta/X hidden until configured). Empty = email link only.
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# --- Payments: Paystack (bank verification + escrow/payouts) ---
# Dashboard → Settings → API Keys & Webhooks. Use TEST keys in dev.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# --- Analytics (all OPTIONAL) — each loads ONLY after cookie consent AND only
# if its ID is set here. Leave blank to disable that provider entirely. ---
# Google Tag Manager container (GTM-XXXXXXX). Configure GA4 / Pixel INSIDE GTM.
# If you use GTM for GA4, leave NEXT_PUBLIC_GA_ID blank to avoid double-counting.
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX) — use this OR GTM, not both.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# --- Identity KYC (primary: Smile ID; backup: Dojah) — add when ready ---
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_ENV=sandbox
DOJAH_APP_ID=
DOJAH_API_KEY=
DOJAH_PUBLIC_KEY=

# --- Cloudinary (profile/showcase VIDEOS; images use Supabase + next/image) ---
# Dashboard → Product Environment Credentials. Secret stays server-side.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Scheduled jobs ---
# Secret that guards /api/cron/* routes (e.g. deliverable storage cleanup).
# Set a long random string and pass it as "Authorization: Bearer <value>".
CRON_SECRET=

# --- Transactional email (OPTIONAL) ---
# Resend (https://resend.com). Without these, email is silently skipped and
# only in-app notifications are delivered. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=
EMAIL_FROM=

# --- AI / false-media detection (OPTIONAL) ---
# Point at a provider that accepts { url } and returns { score: 0..100 }.
# Without it, uploaded media is queued unscored for manual admin review.
AI_DETECT_URL=
AI_DETECT_KEY=
